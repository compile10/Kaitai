# Shared settings (development and production)
# OpenRouter powers sentence analysis and image text extraction in either mode.
# Get your API key from https://openrouter.ai/keys
# Required at production startup; local UI development can run without it.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Docker Compose supplies the local MongoDB URI automatically.
# MONGODB_URI=mongodb://localhost:27017/kaitai?replicaSet=rs0

# Development-only settings
# Dev-only admin seed (created automatically when NODE_ENV=development)
# Defaults: admin@localhost.dev / dev-admin-password
# DEV_ADMIN_EMAIL=admin@localhost.dev
# DEV_ADMIN_PASSWORD=dev-admin-password
# DEV_ADMIN_NAME=Dev Admin

# Production-only configuration (not required for local development)
# Required for production builds and startup: HTTPS origin and random secret.
# Docker Compose supplies the development auth URL automatically.
# BETTER_AUTH_URL=https://kaitai.app
# Generate a secret of at least 32 characters: openssl rand -base64 48
# BETTER_AUTH_SECRET=

# Optional proxy header override; defaults to x-forwarded-for.
# The production proxy must overwrite, not append to, client-supplied values.
# RATE_LIMIT_IP_HEADER=x-forwarded-for
