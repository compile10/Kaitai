{
  "expo": {
    "name": "Kaitai",
    "slug": "kaitai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kaitai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kaitai.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#811007",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.kaitai.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#811007",
          "dark": {
            "backgroundColor": "#811007"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kaitai to access your photos to analyze Japanese text in images.",
          "cameraPermission": "Allow Kaitai to use your camera to photograph Japanese text for analysis."
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "onDemandFilesystem": false,
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "344998b8-5b99-4798-ac33-0c239d9e54da"
      }
    },
    "owner": "compile10"
  }
}
