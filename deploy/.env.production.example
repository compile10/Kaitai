# Production settings for the web service in deploy/compose.yml.
# Copy to deploy/.env.production and restrict it: chmod 600 deploy/.env.production

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Public HTTPS origin; must match the tunnel hostname.
BETTER_AUTH_URL=https://kaitai.app
# openssl rand -base64 48
BETTER_AUTH_SECRET=

# Cloudflare sets this on every tunneled request and overwrites client values.
# The host publishes no ports, so the tunnel is the only way in.
RATE_LIMIT_IP_HEADER=cf-connecting-ip

# Optional SigNoz export; see docs/monitoring.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=YOUR_INGESTION_KEY
# OTEL_SERVICE_NAME=kaitai-web
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
